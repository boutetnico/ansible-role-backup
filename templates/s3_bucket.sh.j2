#!/bin/bash

# {{ ansible_managed }}

set -o errexit   # abort on nonzero exitstatus
set -o nounset   # abort on unbound variable
set -o pipefail  # don't hide errors within pipes

SERVICE={{ item.name }}
DATE=$(date +%Y%m%dT%H%M%S)
DEST_FILE={{ backup_temp_dir }}/${SERVICE}-${DATE}.tar
BUCKET_NAME={{ item.vars.bucket_name }}
S3_SYNC_PATH={{ item.vars.s3_sync_path }}

{% for key, value in backup_env.items() %}
export {{ key }}={{ value }}
{% endfor %}

# Clean orphans from previous failed runs of this service
rm -rf "{{ backup_temp_dir }}/${SERVICE}-"[0-9]* 2>/dev/null || true

finish() {
  result=$?

  rm -rf ${DEST_FILE}
  rm -f "{{ backup_temp_dir }}/${SERVICE}-${DATE}".*

  if [ ${result} -ne 0 ]; then
    echo "Error: non-zero exit code $result" 1>&2
  else
    echo "Backup completed"
  fi

  exit ${result}
}

trap finish EXIT ERR

retry() {
  local attempt
  for (( attempt=1; attempt <= {{ backup_upload_retries }}; attempt++ )); do
    "$@" && return 0
    if [ ${attempt} -lt {{ backup_upload_retries }} ]; then
      echo "Command failed (attempt ${attempt}/{{ backup_upload_retries }}), retrying in $((attempt * {{ backup_upload_retry_delay }}))s..." 1>&2
      sleep $((attempt * {{ backup_upload_retry_delay }}))
    fi
  done
  echo "Command failed after {{ backup_upload_retries }} attempts: $*" 1>&2
  return 1
}

prepare() {
  umask 027

  echo "Starting backup..."

  echo "Syncing remote bucket with local copy..."

  sync_log=$(mktemp)
  sync_status=0
  {{ backup_aws_command }} s3 sync --delete \
              --only-show-errors \
              {{ item.vars.s3_sync_options | d('') }} \
              s3://${BUCKET_NAME}/ ${S3_SYNC_PATH}/ 2>"${sync_log}" || sync_status=$?

  cat "${sync_log}" 1>&2

  if [ ${sync_status} -ne 0 ]; then
{% if item.vars.s3_sync_skip_deleted | d(true) %}
    # Exit code 1 means individual file transfers failed. Tolerate it
    # only when *every* failure is an object that vanished from the
    # bucket between listing and download (NoSuchKey) — any other error
    # (AccessDenied, throttling, no space left, ...) still aborts.
    if [ ${sync_status} -eq 1 ] && [ -s "${sync_log}" ] \
       && ! grep -qvF 'NoSuchKey' "${sync_log}"; then
      echo "Warning: s3 sync skipped objects deleted mid-sync (NoSuchKey)" 1>&2
    else
      echo "Error: s3 sync failed with exit code ${sync_status}" 1>&2
      rm -f "${sync_log}"
      exit ${sync_status}
    fi
{% else %}
    echo "Error: s3 sync failed with exit code ${sync_status}" 1>&2
    rm -f "${sync_log}"
    exit ${sync_status}
{% endif %}
  fi
  rm -f "${sync_log}"

  # Check emptiness
  if [ ! "$(ls -A ${S3_SYNC_PATH})" ]; then
    echo "Error: empty backup" 1>&2
    exit 1
  fi
}

compress() {
{% if item.vars.compression_enabled | d(backup_compression_enabled) %}
  DEST_FILE=${DEST_FILE}.{{ backup_compressor[0:2] }}

  echo "Creating a compressed archive..."

  tar -C ${S3_SYNC_PATH} {{ item.vars.tar_options | d('') }} -cf - . | {{ backup_compressor }} -{{ backup_compression_level }} > ${DEST_FILE}
{% elif item.vars.archive_enabled | d(backup_archive_enabled) %}
  echo "Creating an uncompressed archive..."

  tar -C ${S3_SYNC_PATH} {{ item.vars.tar_options | d('') }} -cf ${DEST_FILE} .
{% else %}
  echo "Skipping archiving and compressing..."
{% endif %}
}

encrypt() {
{% if item.vars.encryption_enabled | d(backup_encryption_enabled) %}
  ENCRYPTED_FILE="${DEST_FILE}.enc"

  echo "Encrypting backup using OpenSSL {{ backup_encryption_algo }}..."

  export BACKUP_ENCRYPTION_KEY={{ backup_encryption_key }}
  openssl enc -{{ backup_encryption_algo }} -salt -pbkdf2 -in "${DEST_FILE}" -out "${ENCRYPTED_FILE}" -pass env:BACKUP_ENCRYPTION_KEY
  unset BACKUP_ENCRYPTION_KEY

  rm -f "${DEST_FILE}"
  DEST_FILE="${ENCRYPTED_FILE}"
{% else %}
  echo "Skipping encrypting..."
{% endif %}
}

upload() {
{% if item.vars.aws_upload_enabled | d(backup_aws_upload_enabled) %}
  echo "Uploading to AWS..."

  retry {{ backup_aws_command }} s3 --region {{ backup_aws_region }} \
        cp --only-show-errors \
        ${DEST_FILE} s3://{{ backup_aws_bucket_name }}/${SERVICE}/
{% endif %}

{% if item.vars.gcloud_upload_enabled | d(backup_gcloud_upload_enabled) %}
  echo "Uploading to GCloud..."

  retry {{ backup_gcloud_command }} -q cp ${DEST_FILE} gs://{{ backup_gcloud_bucket_name }}/${SERVICE}/
{% endif %}

{% if item.vars.b2_upload_enabled | d(backup_b2_upload_enabled) %}
  echo "Uploading to Backblaze B2..."

  retry {{ backup_b2_command }} file upload \
    --no-progress \
    {{ backup_b2_bucket_name }} \
    ${DEST_FILE} \
    ${SERVICE}/$(basename ${DEST_FILE}) \
    > /dev/null
{% endif %}

{% if item.vars.restic_enabled | d(backup_restic_enabled) %}
  {{ backup_restic_command }} --quiet snapshots > /dev/null || {{ backup_restic_command }} --quiet init

  echo "Performing backup through restic..."

  {{ backup_restic_command }} --quiet backup ${S3_SYNC_PATH} --tag ${SERVICE}

  echo "Forgetting old restic snapshots..."

  {{ backup_restic_command }} --quiet forget --tag ${SERVICE} {{ backup_restic_forget_options }}

{%   if item.vars.restic_check_enabled | d(backup_restic_check_enabled) %}
  echo "Checking restic data..."

  {{ backup_restic_command }} --quiet check
{%   endif %}
{% endif %}
}

prepare
compress
encrypt
upload
