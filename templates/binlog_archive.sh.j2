#!/bin/bash

# {{ ansible_managed }}

set -o errexit   # abort on nonzero exitstatus
set -o nounset   # abort on unbound variable
set -o pipefail  # don't hide errors within pipes

SERVICE={{ item.name }}
BINLOG_DIR={{ item.vars.binlog_dir }}
BINLOG_PREFIX={{ item.vars.binlog_prefix | d('mysql-bin') }}
S3_PREFIX={{ item.vars.s3_prefix | d(item.name) }}

{% for key, value in backup_env.items() %}
export {{ key }}="{{ value }}"
{% endfor %}

finish() {
  result=$?

  if [ ${result} -ne 0 ]; then
    echo "Error: non-zero exit code $result" 1>&2
  else
    echo "Backup completed"
  fi

  exit ${result}
}

trap finish EXIT ERR

retry() {
  local attempt
  for (( attempt=1; attempt <= {{ backup_upload_retries }}; attempt++ )); do
    "$@" && return 0
    if [ ${attempt} -lt {{ backup_upload_retries }} ]; then
      echo "Command failed (attempt ${attempt}/{{ backup_upload_retries }}), retrying in $((attempt * {{ backup_upload_retry_delay }}))s..." 1>&2
      sleep $((attempt * {{ backup_upload_retry_delay }}))
    fi
  done
  echo "Command failed after {{ backup_upload_retries }} attempts: $*" 1>&2
  return 1
}

local_binlogs=$(ls -1 "${BINLOG_DIR}" | grep -E "^${BINLOG_PREFIX}\.[0-9]+$" | sort | sed '$d' || true)

if [ -z "${local_binlogs}" ]; then
  echo "No completed binlogs to archive"
  exit 0
fi

remote_binlogs=$({{ backup_aws_command }} s3 --region {{ backup_aws_region }} \
  ls "s3://{{ backup_aws_bucket_name }}/${S3_PREFIX}/" 2>/dev/null | awk '{print $NF}' || true)

archived=0

for binlog in ${local_binlogs}; do
  name="${binlog}{% if item.vars.compression_enabled | d(backup_compression_enabled) %}.{{ backup_compressor[0:2] }}{% endif %}{% if item.vars.encryption_enabled | d(backup_encryption_enabled) %}.enc{% endif %}"

  if echo "${remote_binlogs}" | grep -qxF "${name}"; then
    continue
  fi

  echo "Archiving ${binlog}..."

{% if item.vars.encryption_enabled | d(backup_encryption_enabled) %}
  export BACKUP_ENCRYPTION_KEY={{ backup_encryption_key }}
{% endif %}

  retry bash -o pipefail -c "cat '${BINLOG_DIR}/${binlog}' \
{% if item.vars.compression_enabled | d(backup_compression_enabled) %}
    | {{ backup_compressor }} -{{ backup_compression_level }} \
{% endif %}
{% if item.vars.encryption_enabled | d(backup_encryption_enabled) %}
    | openssl enc -{{ backup_encryption_algo }} -salt -pbkdf2 -pass env:BACKUP_ENCRYPTION_KEY \
{% endif %}
    | {{ backup_aws_command }} s3 --region {{ backup_aws_region }} cp --only-show-errors - 's3://{{ backup_aws_bucket_name }}/${S3_PREFIX}/${name}'"

{% if item.vars.encryption_enabled | d(backup_encryption_enabled) %}
  unset BACKUP_ENCRYPTION_KEY
{% endif %}

  archived=$((archived + 1))
done

echo "Archived ${archived} binlog(s)"
